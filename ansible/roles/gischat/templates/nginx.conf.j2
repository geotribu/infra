##############################
# Auto-generated via Ansible #
#### Do not edit manually ####
##############################

upstream gischat_upstream_{{ gischat_environment }} {
  server 127.0.0.1:{{ gischat_internal_http_port }};
}

server {
  listen 80;
  listen [::]:80;
  server_name {{ ansible_host }};

  # Let's Encrypt HTTP-01 challenges (certbot --webroot), served over plain HTTP
  location ^~ /.well-known/acme-challenge/ {
    root {{ gischat_certbot_webroot }};
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}
{% if gischat_tls_enabled | bool %}

server {

  listen 443 ssl;
  listen [::]:443 ssl;
  server_name {{ ansible_host }};

  ssl_certificate {{ nginx_ssl_certificate }};
  ssl_certificate_key {{ nginx_ssl_certificate_key }};

  error_log /var/log/nginx/{{ ansible_host }}/error.log;
  access_log /var/log/nginx/{{ ansible_host }}/access.log combined;

  location / {
    proxy_pass http://gischat_upstream_{{ gischat_environment }};
    proxy_http_version 1.1;

    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;

    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }
}
{% endif %}
